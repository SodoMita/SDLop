+    uint64_t head = ring->cached_head;
+    if (head - tail < max_elems) {
+        /* Reuse an acquired limit only if it can satisfy the entire request.
+         * Otherwise refresh: don't return a short batch from a stale cache. */
+        head = atomic_load_explicit(&ring->head, memory_order_acquire);
+        if (head == tail) {
+            return 0; /* no cache write on the common idle path */
+        }
+        ring->cached_head = head;
+    }
